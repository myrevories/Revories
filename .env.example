# Copy to .env.local and fill in. With nothing set, the app runs in demo mode
# (in-memory sample archive, no sign-in, photos kept in memory).

# ── Supabase (auth + Postgres) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (photo/video storage) ─────────────────────
# Set to "r2" to upload straight from the browser to R2 via presigned URLs.
NEXT_PUBLIC_STORAGE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=revories-media
# Public/custom-domain base URL for the bucket, e.g. https://media.myrevories.com
R2_PUBLIC_BASE_URL=
